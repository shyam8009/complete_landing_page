),d(6182);var s6=d(171);let s8='Animates the opacity of an element to fade it in or out. Use this preset for entrance or exit animations, revealing content, or smooth visibility transitions.\n\nProperties:\n- timing: Select "Fade In" to animate from transparent to opaque, or "Fade Out" to animate from opaque to transparent.\n- duration: The length of the animation in seconds.\n- easing: The easing curve that controls the acceleration of the fade.',s9=[{name:"timing",type:s5.J0O.TEXT,label:"Timing",defaultText:"in",selectConfig:{options:[{value:"in",label:"In"},{value:"out",label:"Out"}]}},{name:"duration",type:s5.J0O.NUMBER,label:"Duration",defaultNumber:.5,inputConfig:{min:.01,unit:"s"},numberResolvedAsTiming:!0},{name:"easing",type:s5.J0O.EASING,label:"Easing",defaultEasing:{easingType:s5.mgy.OUT_CUBIC}}],s7='Translates an element along the X and Y axes to slide it in or out of position. Use this preset for slide-in or slide-out transitions, off-screen entrances, or directional movement effects.\n\nProperties:\n- timing: Select "Move In" to slide from the offset position to the original position, or "Move Out" to slide from the original position to the offset.\n- moveX: The horizontal translation offset in pixels.\n- moveY: The vertical translation offset in pixels.\n- duration: The length of the animation in seconds.\n- fade: Enable to simultaneously fade the element\'s opacity during the move.\n- easing: The easing curve that controls the acceleration of the movement.',le=[{name:"timing",type:s5.J0O.TEXT,label:"Timing",defaultText:"out",selectConfig:{options:[{value:"in",label:"In"},{value:"out",label:"Out"}]}},{name:"moveX",type:s5.J0O.NUMBER,label:"Move X",defaultNumber:100},{name:"moveY",type:s5.J0O.NUMBER,label:"Move Y",defaultNumber:0},{name:"duration",type:s5.J0O.NUMBER,label:"Duration",defaultNumber:.5,inputConfig:{min:.01,unit:"s"},numberResolvedAsTiming:!0},{name:"fade",type:s5.J0O.BOOL,label:"Fade",defaultBool:!1},{name:"easing",type:s5.J0O.EASING,label:"Easing",defaultEasing:{easingType:s5.mgy.OUT_CUBIC}}],lt="motion.preset_name.corner_radius",ln='Animates the corner radius of a node, either uniformly or per-corner. Use this preset for "round in / round out" reveal effects, or pick the Custom type for explicit start / end radius values per corner.\n\nProperties:\n- type: "Round in" animates 0 \u2192 amount; "Round out" animates amount \u2192 0; "Custom" lets each corner specify explicit start / end values.\n- corner: "All" drives the shared `cornerRadius` field; the four specific corner values drive only that corner. Toggling between "All" and a specific corner relies on the C++ preset bind path to flip `rectangleCornerRadiiIndependent` (see `_bindKeyframeExpressionToParameterField`).\n- amount: For type=roundIn/roundOut, the target radius in px.\n- *StartFrame / *EndFrame: For type=custom, the per-corner start/end radii. Only the pair matching the current `corner` selection is animated.\n- delay / duration / easing: Shared timing for the animation.',lr=[{name:"type",type:s5.J0O.TEXT,label:"motion.preset_flyout.type",defaultText:"roundIn",selectConfig:{options:[{value:"roundIn",label:"motion.preset_flyout.corner_radius.type.round_in"},{value:"roundOut",label:"motion.preset_flyout.corner_radius.type.round_out"},{value:"custom",label:"motion.preset_flyout.type.custom"}]}},{name:"corner",type:s5.J0O.TEXT,label:"motion.preset_flyout.corner_radius.corner",defaultText:"all",selectConfig:{options:[{value:"all",label:"motion.preset_flyout.corner_radius.corner.all"},{value:"topLeft",label:"motion.preset_flyout.corner_radius.corner.top_left"},{value:"topRight",label:"motion.preset_flyout.corner_radius.corner.top_right"},{value:"bottomLeft",label:"motion.preset_flyout.corner_radius.corner.bottom_left"},{value:"bottomRight",label:"motion.preset_flyout.corner_radius.corner.bottom_right"}]}},{name:"amount",type:s5.J0O.NUMBER,label:"motion.preset_flyout.amount",defaultNumber:10,inputConfig:{min:0,unit:"px"}},{name:"allStartFra