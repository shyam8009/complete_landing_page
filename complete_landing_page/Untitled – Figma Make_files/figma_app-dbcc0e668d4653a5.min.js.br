 document.close();
 document.addEventListener('keydown', (e) => {
   if (e.key === 'F6' && !e.altKey && !e.metaKey && ${l.A.mac?"true":"e.ctrlKey"}) {
     // Handle F6 accessible area cycling shortcuts
     // On Mac: F6 / Shift+F6. On non-Mac: Ctrl+F6 / Shift+Ctrl+F6.
     if (e.shiftKey) {
       window.parent.postMessage('${y.m1}', '*')
     } else {
       window.parent.postMessage('${y.kG}', '*')
     }
     e.preventDefault()
     e.stopPropagation()
     e.stopImmediatePropagation()
   } else if (e.keyCode === 80 /* P */ && !e.shiftKey && e.altKey && ${l.A.mac?"!e.ctrlKey && e.metaKey":"e.ctrlKey && !e.metaKey"}) {
     // Handle the plugin re-run shortcut
     window.parent.postMessage('${y.IN}', '*')
     e.stopPropagation()
     e.stopImmediatePropagation()
   } else if (${JSON.stringify(v)}) {
     // Handle Select All, Undo and Redo in the desktop app
     const ctrlDown = ${l.A.mac?"e.metaKey":"e.ctrlKey"}
     if (ctrlDown) {
       if (e.keyCode === 65 /* A */) {
         document.execCommand('selectAll')
       } else if (e.keyCode === 90 /* Z */) {
         if (e.shiftKey) {
           document.execCommand('redo')
         } else {
           document.execCommand('undo')
         }
       } else if ((e.key === 'x' || e.key === 'X') && ${JSON.stringify((0,g.T)())}) {
         document.execCommand('cut')
       } else if ((e.key === 'c' || e.key === 'C') && ${JSON.stringify((0,g.T)())}) {
         document.execCommand('copy')
       } else if ((e.key === 'v' || e.key === 'V') && ${JSON.stringify((0,g.T)())}) {
         document.execCommand('paste')
       }
     }
   }
 }, true)

 function renderCssVariables(vars) {
   return Object.entries(vars)
     .map((entry) => entry.join(': '))
     .join('; ') + ';'
 }

 window.addEventListener('message', function(event) {
   if (
     event.source === ${y.NO} &&
     event.data &&
     typeof event.data === 'object' &&
     'figmaMessage' in event.data
   ) {
     event.stopImmediatePropagation()

     const figmaMessage = event.data.figmaMessage

     if (figmaMessage.type === 'THEME') {
       const figmaStyle = document.getElementById('figma-style')
       figmaStyle.textContent = ':root { ' + renderCssVariables(figmaMessage.payload.variables) + ' }'

       const classesToRemove = []

       document.documentElement.classList.forEach((value) => {
         if (value.startsWith('figma-')) {
           classesToRemove.push(value)
         }
       })

       for (const className of classesToRemove) {
         document.documentElement.classList.remove(className)
       }

       if (figmaMessage.payload.name && figmaMessage.payload.name !== 'legacy') {
         document.documentElement.classList.add('figma-' + figmaMessage.payload.name)
       }
     }
   }
 }, true)

 // Forward uncaught errors from the plugin UI to the host so they can be added
 // to the custom-tool diagnostics buffer (powers the assistant "Fix for me"
 // flow). Capture phase + no preventDefault so the plugin's own error handling
 // and the console are unaffected. The host ignores these unless a custom-tool
 // run is being captured.
 window.addEventListener('error', function(event) {
   try {
     var err = event.error
     var message = (err && err.message) || event.message || 'Unknown error'
     var stack = (err && err.stack) || ''
     window.parent.postMessage({ pluginUIError: { message: message, stack: stack } }, '*')
   } catch (e) {}
 }, true)

 window.addEventListener('unhandledrejection', function(event) {
   try {
     var reason = event.reason
     var message = (reason && reason.message) || String(reason)
     var stack = (reason && reason.stack) || ''
     window.parent.postMessage({ pluginUIError: { message: message, stack: stack, isUnhandledRejection: true } }, '*')
   } catch (e) {}
 }, true)
